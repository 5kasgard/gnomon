@@ -0,0 +1,93 @@
+"""Issue #48, arm I2: from protocol version 7 an instance's id is exactly '<parent>-<n>', n one
+more than the instances the parent has started: the sender chooses nothing. Version 6 logs keep
+the old rule."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import gnomon as g
+from gnomon.session import instance_for
+
+T = lambda n: f"2026-01-01T00:{n:02d}:00Z"  # noqa: E731
+
+
+def code(fn):
+    try:
+        fn()
+        return "accepted"
+    except g.GateError as e:
+        return e.code
+
+
+def make(path, version=None):
+    m = g.Memory(path)
+    if version is None:
+        m.register("o", "o", party="o", kind="human", capabilities=["owner"], compartments=["a", "b"], record_time=T(0))
+    else:
+        m.append("o", "register", {"writer": "o", "party": "o", "kind": "human", "capabilities": ["owner"],
+                                   "compartments": ["a", "b"], "schema_version": version}, T(0))
+    for w, c in (("c", "a"), ("c-x", "b")):
+        m.register("o", w, party="p", kind="model", model="m", operator="o", name="C",
+                   capabilities=["write", "spawn"], compartments=[c], record_time=T(1))
+    return m
+
+
+def inst(m, parent, wid, comp):
+    return code(lambda: m.register(parent, wid, party="p", kind="model", model="m", operator="o", name="C",
+                                   capabilities=["write"], compartments=[comp], record_time=T(2)))
+
+
+class GateAssignedIds(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = Path(self.dir.name) / "m.jsonl"
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_the_next_number_is_accepted_and_nothing_else(self):
+        m = make(self.path)
+        self.assertEqual(inst(m, "c", "c-2", "a"), "E_SPAWN")
+        self.assertEqual(inst(m, "c", "c-x-1", "a"), "E_SPAWN")
+        self.assertEqual(inst(m, "c", "c-1", "a"), "accepted")
+        self.assertEqual(inst(m, "c", "c-1", "a"), "E_DUPLICATE")
+        self.assertEqual(inst(m, "c", "c-2", "a"), "accepted")
+        self.assertEqual(inst(m, "c-x", "c-x-1", "b"), "accepted")
+
+    def test_the_parent_counts_its_own_instances_only(self):
+        m = make(self.path)
+        inst(m, "c", "c-1", "a")
+        self.assertEqual(inst(m, "c-x", "c-x-1", "b"), "accepted")  # c's count does not move c-x's
+
+    def test_a_refusal_depends_only_on_the_senders_own_instances(self):
+        outs = []
+        for hidden in (True, False):
+            with tempfile.TemporaryDirectory() as d:
+                m = make(Path(d) / "m.jsonl")
+                if hidden:
+                    inst(m, "c", "c-1", "a")
+                    inst(m, "c", "c-x-1", "a")  # refused
+                outs.append([inst(m, "c-x", f"c-x-{i}", "b") for i in (0, 1, 2)])
+        self.assertEqual(outs[0], outs[1])
+
+    def test_version_6_logs_keep_the_old_rule(self):
+        m = make(self.path, version=6)
+        self.assertEqual(inst(m, "c", "c-7", "a"), "accepted")
+
+    def test_session_instances_still_start(self):
+        m = make(self.path)
+        w1 = instance_for(m, "c-x", "s1")
+        w2 = instance_for(m, "c-x", "s2")
+        self.assertEqual((w1, w2), ("c-x-1", "c-x-2"))
+        self.assertEqual(instance_for(m, "c-x", "s1"), "c-x-1")
+
+    def test_session_instances_on_an_old_log_with_a_gap(self):
+        m = make(self.path, version=6)
+        inst(m, "c", "c-1", "a")
+        inst(m, "c", "c-3", "a")
+        self.assertEqual(instance_for(m, "c", "s9"), "c-4")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/python/tests/test_issue_48_o1.py b/python/tests/test_issue_48_o1.py
new file mode 100644
index 0000000..3c13f1e
--- /dev/null
+++ b/python/tests/test_issue_48_o1.py
@@ -0,0 +1,73 @@
+"""Issue #48, arm O1: from protocol version 7 a restricted view (writers, state, Datalog identity
+facts) names a writer's operator only to a reader who shares a compartment with the operator."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import gnomon as g
+
+T = lambda n: f"2026-01-01T00:{n:02d}:00Z"  # noqa: E731
+
+
+def make(path, version=None, op_comps=("a",)):
+    m = g.Memory(path)
+    if version is None:
+        m.register("o", "o", party="o", kind="human", capabilities=["owner"], compartments=["a", "b"], record_time=T(0))
+    else:
+        m.append("o", "register", {"writer": "o", "party": "o", "kind": "human", "capabilities": ["owner"],
+                                   "compartments": ["a", "b"], "schema_version": version}, T(0))
+    m.register("o", "op", party="po", kind="human", capabilities=["write"], compartments=list(op_comps), record_time=T(1))
+    m.register("o", "bot", party="pb", kind="model", model="m", operator="op", capabilities=["write"],
+               compartments=["b"], record_time=T(1))
+    m.register("o", "wb", party="pwb", kind="human", capabilities=["write"], compartments=["b"], record_time=T(1))
+    return m
+
+
+def ident(m):
+    return [a["values"] for a in m.query("wb", '?- identity("bot", "operator", V).', proofs=0)["answers"]]
+
+
+class OperatorVisibility(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = Path(self.dir.name) / "m.jsonl"
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_hidden_from_a_reader_who_shares_nothing_with_the_operator(self):
+        m = make(self.path)
+        self.assertNotIn("operator", m.writers(compartments=["b"])["bot"])
+        self.assertNotIn("operator", m.state(compartments=["b"])["state"]["writers"]["bot"])
+        self.assertEqual(ident(m), [])
+
+    def test_shown_to_a_reader_who_shares_a_compartment_with_it(self):
+        m = make(self.path, op_comps=("a", "b"))
+        self.assertEqual(m.writers(compartments=["b"])["bot"]["operator"], "op")
+        self.assertEqual(ident(m), [["op"]])
+
+    def test_the_full_view_still_shows_it(self):
+        m = make(self.path)
+        self.assertEqual(m.writers()["bot"]["operator"], "op")
+
+    def test_two_worlds_differing_only_in_which_hidden_operator_look_alike(self):
+        outs = []
+        for who in ("op", "op2"):
+            with tempfile.TemporaryDirectory() as d:
+                m = make(Path(d) / "m.jsonl")
+                m.register("o", "op2", party="po2", kind="human", capabilities=["write"], compartments=["a"],
+                           record_time=T(1))
+                m.register("o", "bot2", party="pb2", kind="model", model="m", operator=who, capabilities=["write"],
+                           compartments=["b"], record_time=T(2))
+                outs.append((m.writers(compartments=["b"])["bot2"], ident(m)))
+        self.assertEqual(outs[0], outs[1])
+
+    def test_version_6_logs_hide_it_too(self):  # follow-up G: O1 applies to every log
+        m = make(self.path, version=6)
+        self.assertNotIn("operator", m.writers(compartments=["b"])["bot"])
+        self.assertEqual(ident(m), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/python/tests/test_issue_48_s1.py b/python/tests/test_issue_48_s1.py
new file mode 100644
index 0000000..29ab6e6
--- /dev/null
+++ b/python/tests/test_issue_48_s1.py
@@ -0,0 +1,68 @@
+"""Issue #48, arm S1: the one-session-one-writer check looks only at writers that share a
+compartment with the one being registered, so its refusal says nothing about hidden compartments."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import gnomon as g
+
+T = lambda n: f"2026-01-01T00:{n:02d}:00Z"  # noqa: E731
+
+
+def code(fn):
+    try:
+        fn()
+        return "accepted"
+    except g.GateError as e:
+        return e.code
+
+
+class SessionScope(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.m = g.Memory(Path(self.dir.name) / "m.jsonl")
+        self.m.register("o", "o", party="o", kind="human", capabilities=["owner"], compartments=["a", "b"],
+                        record_time=T(0))
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def reg(self, wid, comps, session="sess"):
+        return code(lambda: self.m.register(
+            "o", wid, party="anthropic", kind="model", model="m", operator="o", name="Claude",
+            surface="claude-code", capabilities=["write"], compartments=comps, session=session, record_time=T(1)))
+
+    def test_same_compartment_is_still_refused(self):
+        self.assertEqual(self.reg("w1", ["a"]), "accepted")
+        self.assertEqual(self.reg("w2", ["a"]), "E_IDENTITY")
+
+    def test_overlapping_compartments_are_still_refused(self):
+        self.assertEqual(self.reg("w1", ["a", "b"]), "accepted")
+        self.assertEqual(self.reg("w2", ["b"]), "E_IDENTITY")
+
+    def test_disjoint_compartments_do_not_collide(self):
+        self.assertEqual(self.reg("w1", ["a"]), "accepted")
+        self.assertEqual(self.reg("w2", ["b"]), "accepted")
+
+    def test_a_refusal_in_b_does_not_depend_on_a(self):
+        """Two logs differing only in an A-side session: B's attempt gets the same answer."""
+        outs = []
+        for hidden in (True, False):
+            with tempfile.TemporaryDirectory() as d:
+                m = g.Memory(Path(d) / "m.jsonl")
+                m.register("o", "o", party="o", kind="human", capabilities=["owner"], compartments=["a", "b"],
+                           record_time=T(0))
+                if hidden:
+                    m.register("o", "wa", party="anthropic", kind="model", model="m", operator="o", name="Claude",
+                               surface="claude-code", capabilities=["write"], compartments=["a"], session="s",
+                               record_time=T(1))
+                outs.append(code(lambda: m.register(
+                    "o", "wb", party="anthropic", kind="model", model="m", operator="o", name="Claude",
+                    surface="claude-code", capabilities=["write"], compartments=["b"], session="s",
+                    record_time=T(2))))
+        self.assertEqual(outs[0], outs[1])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/python/tests/test_issue_48_t1.py b/python/tests/test_issue_48_t1.py
new file mode 100644
index 0000000..c5d0f32
--- /dev/null
+++ b/python/tests/test_issue_48_t1.py
@@ -0,0 +1,99 @@
+"""Issue #48, arm T1: from protocol version 7 the clock rule ("record time never runs backwards")
+compares a new event's time only with events touching the writer's compartments (and global
+ones). A single-compartment log still refuses an out-of-order time; version 6 logs keep the
+whole-log rule."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import gnomon as g
+
+T = lambda n: f"2026-01-01T00:{n:02d}:00Z"  # noqa: E731
+
+
+def make(path, version=None, single=False):
+    m = g.Memory(path)
+    comps = ["a"] if single else ["a", "b"]
+    if version is None:
+        m.register("o", "o", party="o", kind="human", capabilities=["owner"], compartments=comps, record_time=T(0))
+    else:
+        m.append("o", "register", {"writer": "o", "party": "o", "kind": "human", "capabilities": ["owner"],
+                                   "compartments": comps, "schema_version": version}, T(0))
+    for w, c in (("wa", ["a"]), ("wa2", ["a"]), ("wb", ["b"] if not single else ["a"]), ("x", comps)):
+        m.register("o", w, party="p" + w, kind="model", model="m", operator="o", capabilities=["write"],
+                   compartments=c, record_time=T(1))
+    return m
+
+
+def say(m, w, comp, t):
+    try:
+        m.remember(w, g.claim(f"{w}@{t}", speaker=w, frame="f", compartment=comp), t)
+        return "accepted"
+    except g.GateError as e:
+        return e.code
+
+
+class ClockScope(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.path = Path(self.dir.name) / "m.jsonl"
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_a_hidden_later_event_no_longer_blocks_an_earlier_write(self):
+        m = make(self.path)
+        say(m, "wa", "a", T(9))
+        self.assertEqual(say(m, "wb", "b", T(5)), "accepted")
+
+    def test_the_two_worlds_agree(self):
+        outs = []
+        for hidden in (True, False):
+            with tempfile.TemporaryDirectory() as d:
+                m = make(Path(d) / "m.jsonl")
+                if hidden:
+                    say(m, "wa", "a", T(9))
+                outs.append(say(m, "wb", "b", T(5)))
+        self.assertEqual(outs[0], outs[1])
+
+    def test_within_a_compartment_time_still_may_not_go_back(self):
+        m = make(self.path)
+        say(m, "wa", "a", T(9))
+        self.assertEqual(say(m, "wa2", "a", T(5)), "E_CLOCK")
+        say(m, "wb", "b", T(7))
+        self.assertEqual(say(m, "wb", "b", T(6)), "E_CLOCK")
+
+    def test_a_shared_writer_is_held_to_both_of_its_compartments(self):
+        m = make(self.path)
+        say(m, "wa", "a", T(9))
+        self.assertEqual(say(m, "x", "b", T(5)), "E_CLOCK")
+
+    def test_a_single_compartment_log_still_refuses_an_out_of_order_time(self):
+        m = make(self.path, single=True)
+        say(m, "wa", "a", T(9))
+        self.assertEqual(say(m, "wb", "a", T(5)), "E_CLOCK")
+
+    def test_version_6_logs_keep_the_whole_log_rule(self):
+        m = make(self.path, version=6)
+        say(m, "wa", "a", T(9))
+        self.assertEqual(say(m, "wb", "b", T(5)), "E_CLOCK")
+
+    def test_the_log_replays_and_verifies(self):
+        m = make(self.path)
+        say(m, "wa", "a", T(9))
+        say(m, "wb", "b", T(5))
+        self.assertTrue(m.verify()["ok"])
+
+    def test_known_cost_as_of_stops_at_the_first_later_dated_event(self):
+        """as_of replays a prefix of the log. With out-of-order times across compartments the prefix
+        ends at the first event dated after the cut, so b's earlier-dated event is not in it."""
+        m = make(self.path)
+        say(m, "wa", "a", T(9))
+        say(m, "wb", "b", T(5))
+        st = m.state(as_of=T(6))["state"]
+        self.assertEqual([c["body"]["statement"] for c in st["claims"].values()], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/python/tests/test_issue_48_v1.py b/python/tests/test_issue_48_v1.py
new file mode 100644
index 0000000..6a122f7
--- /dev/null
+++ b/python/tests/test_issue_48_v1.py
@@ -0,0 +1,71 @@
+"""Issue #48, arm V1: a query's `through` (where the reader's view ends) shows a lease or release
+only if the leased writer shares a compartment with the reader, a revocation only if its target
+does; a schema change shows to all. No state changes, so old logs replay identically."""
+
+import tempfile
+import unittest
+from pathlib import Path
+
+import gnomon as g
+
+T = lambda n: f"2026-01-01T00:{n:02d}:00Z"  # noqa: E731
+FAR = "2099-01-01T00:00:00Z"
+
+
+def make(path):
+    m = g.Memory(path)
+    m.register("o", "o", party="o", kind="human", capabilities=["owner", "govern"], compartments=["a", "b"],
+               record_time=T(0))
+    for w, c in (("wa", ["a"]), ("wb", ["b"]), ("rb", ["b"])):
+        m.register("o", w, party="p" + w, kind="model", model="m", operator="o", capabilities=["write"],
+                   compartments=c, record_time=T(1))
+    m.remember("wb", g.claim("b fact", speaker="wb", frame="f", compartment="b"), T(2))
+    return m
+
+
+def through(m, reader="rb"):
+    return (m.query(reader, "?- claim(C).", proofs=0)["through"] or {}).get("event")
+
+
+class ThroughHidesLeases(unittest.TestCase):
+    def setUp(self):
+        self.dir = tempfile.TemporaryDirectory()
+        self.m = make(Path(self.dir.name) / "m.jsonl")
+
+    def tearDown(self):
+        self.dir.cleanup()
+
+    def test_a_lease_to_a_hidden_writer_is_not_the_end_of_the_view(self):
+        before = through(self.m)
+        self.m.lease("o", "wa", "fa", FAR, record_time=T(5))
+        self.assertEqual(through(self.m), before)
+
+    def test_release_and_revoke_of_a_hidden_writer_are_not_either(self):
+        before = through(self.m)
+        lid = self.m.lease("o", "wa", "fa", FAR, record_time=T(5))
+        self.m.release("o", lid, record_time=T(6))
+        self.m.revoke("o", "wa", ["a"], "test", record_time=T(7))
+        self.assertEqual(through(self.m), before)
+
+    def test_a_reader_who_shares_the_targets_compartment_still_sees_lease_events(self):
+        lid = self.m.lease("o", "wb", "fb", FAR, record_time=T(5))
+        self.assertEqual(through(self.m), lid)
+        rel = self.m.release("o", lid, record_time=T(6))["event_id"]
+        self.assertEqual(through(self.m), rel)
+
+    def test_a_revoke_of_a_writer_the_reader_shares_with_is_seen(self):
+        rv = self.m.revoke("o", "wb", ["b"], "test", record_time=T(5))["event_id"]
+        # wb now holds nothing, so by the rule (the target shares a compartment) the revoke is not shown;
+        # revoking one of two compartments leaves the target visible:
+        self.assertNotEqual(through(self.m), rv)
+
+    def test_a_schema_change_is_seen_by_everyone(self):
+        sc = self.m.append("o", "schema_change", {"version": 7, "description": "x"}, T(5))["event_id"] \
+            if self.m.state()["state"]["schema_version"] < 7 else None
+        if sc is None:
+            self.skipTest("already at the newest version")
+        self.assertEqual(through(self.m), sc)
+
+
+if __name__ == "__main__":
+    unittest.main()
